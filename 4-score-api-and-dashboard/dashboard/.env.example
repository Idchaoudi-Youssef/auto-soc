# Copy to .env on the dashboard VM (read by app.py)
#
# DASHBOARD_SECRET_KEY and ANALYST_PASSWORD are mandatory: the dashboard refuses
# to start while they hold the placeholder below. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_SECRET_KEY=change_me
SHUFFLE_APPROVAL_WEBHOOK=http://192.168.56.11:3001/api/v1/hooks/<DASHBOARD_DECISION_WEBHOOK_ID>
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=change_me

# Optional. When set, POST /api/alerts requires the header "X-Ingest-Token: <value>".
# Leave empty to keep the lab default (open ingest endpoint).
INGEST_TOKEN=
